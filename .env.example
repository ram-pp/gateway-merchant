# ── merchant-pay API ── copy to apps/api/.env and fill in ───────────────────

NODE_ENV=development
PORT=4000

# Own MongoDB — never share ssPaymentSolutions' database
MONGO_URI=mongodb://127.0.0.1:27017/merchant_pay

# Base URL this API is reachable at (used to build payUrl / SSE links)
API_BASE_URL=http://localhost:4000
# Public pay-page host (merchant-web)
PAY_PAGE_BASE_URL=http://localhost:5173

# CORS — merchant-web + admin-web origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT secrets — DIFFERENT audiences, DIFFERENT secrets. Never reuse across panels.
MERCHANT_JWT_SECRET=change-me-merchant-secret
MERCHANT_JWT_EXPIRES_IN=12h
PLATFORM_ADMIN_JWT_SECRET=change-me-platform-admin-secret
PLATFORM_ADMIN_JWT_EXPIRES_IN=12h

# Default payment TTL when expiresInSeconds is omitted
DEFAULT_PAYMENT_TTL_SECONDS=900

# Forwarder matching window (minutes) for late/duplicate events
FORWARDER_MATCH_WINDOW_MIN=30

# Webhook delivery worker
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_WORKER_INTERVAL_MS=5000

# Bootstrap superadmin (used by `npm run seed`)
SEED_SUPERADMIN_EMAIL=admin@merchant-pay.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
